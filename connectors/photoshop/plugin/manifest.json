{
  "manifestVersion": 5,
  "id": "com.sonder.photoshop",
  "name": "Sonder",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "sonderPanel",
      "label": { "default": "Sonder" },
      "minimumSize": { "width": 230, "height": 200 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 260, "height": 320 },
      "preferredFloatingSize": { "width": 260, "height": 320 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["http://localhost:3000", "http://127.0.0.1:3000"]
    },
    "localFileSystem": "request"
  }
}
