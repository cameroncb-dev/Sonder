# Copy to services/vision/.env. Never commit .env.

# Shared secret; must match VISION_SERVICE_TOKEN in apps/web/.env.local (generate with: openssl rand -hex 32)
VISION_SERVICE_TOKEN=
# Request body limit in bytes (default 20 MiB)
VISION_MAX_UPLOAD_BYTES=20971520
# Max decoded image size in pixels (default 50 megapixels)
VISION_MAX_IMAGE_PIXELS=50000000
