# Copy to apps/web/.env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API Keys) ---
# Local stack: run `supabase status` from the repo root.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS. Never expose to the browser or the Photoshop plugin.
SUPABASE_SECRET_KEY=

# --- Vision service ---
VISION_SERVICE_URL=http://127.0.0.1:8000
# Must match VISION_SERVICE_TOKEN in services/vision/.env (generate with: openssl rand -hex 32)
VISION_SERVICE_TOKEN=

# --- Language interpretation (optional; disabled when unset) ---
# none | anthropic
# none | anthropic | gemini. AI features stay off until a provider and its key are set.
LLM_PROVIDER=none
LLM_MODEL=
ANTHROPIC_API_KEY=
# From Google AI Studio (aistudio.google.com). Server-only; never sent to the browser or plugin.
GEMINI_API_KEY=
